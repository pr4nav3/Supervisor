{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Supervisor",
  "version": "1.0.0",
  "identifier": "app.supervisor.desktop",
  "build": {
    "beforeDevCommand": "npm run dev:ui",
    "beforeBuildCommand": "npm run build:ui",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Supervisor",
        "width": 920,
        "height": 760,
        "minWidth": 920,
        "minHeight": 600,
        "center": true,
        "preventOverflow": true,
        "resizable": true,
        "acceptFirstMouse": true,
        "dragDropEnabled": false,
        "backgroundThrottling": "disabled",
        "backgroundColor": "#f4ead7"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost asset: http://asset.localhost https://asset.localhost; img-src 'self' data: blob:; media-src 'self' asset: http://asset.localhost blob:; style-src 'self' 'unsafe-inline'",
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/voice/**"]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQwQzE2NTE4RUI2MEM3MTMKUldRVHgyRHJHR1hCUUswQ0h4UnpFeGRiZWVtM3JYTzg1alZrMlJKQnVURmR6bUlSZ2xVcUNzdk0K",
      "endpoints": ["https://github.com/pr4nav3/Supervisor/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/512x512.png",
      "icons/512x512@2x.png",
      "icons/icon.ico"
    ],
    "macOS": {
      "infoPlist": "Info.plist"
    }
  }
}
